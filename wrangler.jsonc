{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tetonvalley-us",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "vars": { "SITE_URL": "https://tetonvalley.us", "TURNSTILE_SITE_KEY": "" },
  // Create the database, then replace this ID before deploying.
  "d1_databases": [{ "binding": "DB", "database_name": "tetonvalley-submissions", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }]
}
