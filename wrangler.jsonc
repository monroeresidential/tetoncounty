{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tetoncounty-us",
  "account_id": "9441a00a44eb2bc68c2befd68119f256",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "vars": {
    "SITE_URL": "https://tetoncounty.us",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFaYeLDGByrsxlbY",
    "FORMSPREE_FORM_ID": "meaedrjo"
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tetonvalley-submissions",
      "database_id": "eb1f2d58-fc6e-40a3-9fa0-0130ee2e3fa5",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "tetoncounty.us",
      "custom_domain": true
    }
  ]
}
