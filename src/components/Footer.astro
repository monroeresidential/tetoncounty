---
import Icon from './Icon.astro';
import SponsorCard from './SponsorCard.astro';
import { reviewedDate } from '../config.ts';
---
<section class="section close-block" aria-label="Be part of the guide">
  <div class="community-card">
    <h2>The best guides are built together.</h2>
    <p>Know a place we’re missing? Have a detail to update? You’re in the right place.</p>
    <a class="btn btn-primary" href="/suggest/">Share a local spot <Icon name="arrow" /></a>
  </div>
  <SponsorCard />
</section>
<footer class="footer">
  <a class="brand" href="/">Teton Valley <small>Good days start here.</small></a>
  <nav aria-label="Footer navigation"><a href="/explore/">Explore</a><a href="/hiking/">Hiking guide</a><a href="/suggest/?type=contact">Contact</a><a href="/about/">Our sources</a><a href="/privacy/">Privacy</a></nav>
  <span>© {reviewedDate.slice(0, 4)} TetonCounty.us</span>
</footer>
