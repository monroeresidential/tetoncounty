---
import Icon from './Icon.astro';
import SponsorCard from './SponsorCard.astro';
import { reviewedDate } from '../config.ts';
---
<section class="section close-block" aria-label="Be part of the guide">
  <div class="community-card">
    <span class="handwritten">know a spot we missed?</span>
    <h2>The best guides are built together.</h2>
    <p>Have a detail to update? You’re in the right place.</p>
    <a class="btn btn-primary" href="/suggest/">Share a local spot <Icon name="arrow" /></a>
  </div>
  <SponsorCard />
</section>
<footer class="footer">
  <span>© {reviewedDate.slice(0, 4)} TetonCounty.us · Made for getting out there.</span>
  <nav aria-label="Footer navigation"><a href="/explore/">Explore</a><a href="/hiking/">Hiking guide</a><a href="/suggest/">Share a spot</a><a href="/about/">Our sources</a><a href="/privacy/">Privacy</a></nav>
</footer>
