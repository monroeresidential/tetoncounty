---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { cardSizes, directoryCardSizes } from '../lib/images.ts';
import type { Listing } from '../lib/listing-schema.ts';
import { category, imageFor, tag } from '../lib/listings.ts';
interface Props { item: Listing; feature?: boolean }
const { item, feature = false } = Astro.props;
const photo = imageFor(item), c = category(item.category);
---
<article class={`place-card ${feature ? 'featured-card' : 'card'}`} data-listing={item.id} data-town={item.town} data-category={item.category} data-difficulty={item.trail?.difficulty?.toLowerCase() || ''} data-seasons={item.seasons.join(' ')} data-search={[item.name, item.description, item.town, item.subcategory, ...item.tags].join(' ').toLowerCase()}>
  {(feature || photo) && <a class={`card-photo plate ${!feature ? 'directory-photo' : ''} ${!photo ? 'illustrated' : ''}`} href={`/places/${item.id}/`} tabindex="-1" aria-hidden="true">
    {photo ? <Photo src={photo} alt="" sizes={feature ? cardSizes : directoryCardSizes} /> : <Icon name={c.icon} />}
  </a>}
  <div class="card-body">
    {!feature && <div class="card-meta"><span><Icon name="pin" />{item.town}</span><span>{item.subcategory || c.short}</span></div>}
    <div class="card-title-row"><h3><a href={`/places/${item.id}/`}>{item.name}</a></h3>{feature && <span class="card-town">{item.town}</span>}</div>
    {!feature && <p>{item.description}</p>}
    {!feature && item.trail ? <dl class="trail-facts">
      <div><dt>Distance</dt><dd>{item.trail.distanceLabel || (item.trail.distanceMiles != null ? `${item.trail.distanceMiles} mi` : 'Not listed')}</dd></div>
      <div><dt>Gain</dt><dd>{item.trail.elevationFeet != null ? `${item.trail.elevationFeet.toLocaleString('en-US')} ft` : 'Not listed'}</dd></div>
      <div><dt>Difficulty</dt><dd>{item.trail.difficulty ? tag(item.trail.difficulty) : 'Not listed'}</dd></div>
    </dl> : item.note && <p class="card-note handwritten">{item.note}</p>}
  </div>
</article>
