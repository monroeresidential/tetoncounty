---
import Icon from './Icon.astro';
import SponsorLink from './SponsorLink.astro';
import { siteName } from '../config.ts';
interface Props { path: string }
const { path } = Astro.props;
---
<div class="topline">
  <span class="topline-place"><span class="topline-towns">Victor · Driggs · Teton Valley, Idaho</span><a class="pass-badge" href="/teton-pass/" data-pass-badge hidden><span class="pass-badge-dot" aria-hidden="true"></span><span data-pass-badge-text>Teton Pass</span></a></span>
  <SponsorLink placement="header_sponsor">A community guide supported by <span>Teton Flats</span><Icon name="northeast" /></SponsorLink>
</div>
<header class="header nav">
  <a class="brand nav-brand" href="/" aria-label={`${siteName} home`}><Icon name="mountain" /><span>{siteName} <small>Idaho · The other side</small></span></a>
  <button class="menu-toggle btn btn-secondary" aria-expanded="false" aria-controls="navigation" aria-label="Toggle navigation"><Icon name="menu" /></button>
  <nav id="navigation" aria-label="Main navigation">
    <a aria-current={path === '/explore/' ? 'page' : undefined} href="/explore/">Explore</a>
    <a aria-current={path.startsWith('/towns/') ? 'page' : undefined} href="/towns/victor/">Victor & Driggs</a>
    <a aria-current={path === '/hiking/' ? 'page' : undefined} href="/hiking/">Trails</a>
    <a aria-current={path === '/live/' ? 'page' : undefined} href="/live/">Live here</a>
    <a aria-current={path === '/corporate-housing/' ? 'page' : undefined} href="/corporate-housing/">Corporate housing</a>
    <a aria-current={path === '/teton-pass/' ? 'page' : undefined} href="/teton-pass/">Teton Pass</a>
    <a aria-current={path === '/webcams/' ? 'page' : undefined} href="/webcams/">Webcams</a>
    <a aria-current={path === '/about/' ? 'page' : undefined} href="/about/">About</a>
    <a class="btn btn-primary header-cta" aria-current={path === '/suggest/' ? 'page' : undefined} href="/suggest/">+ Add a spot</a>
  </nav>
</header>
