---
import type { Listing } from '../lib/listing-schema.ts';
import { safeJson } from '../lib/listings.ts';
interface Props { listings: Listing[] }
const points = Astro.props.listings.filter(l => Number.isFinite(l.latitude) && Number.isFinite(l.longitude));
const mapData = points.map(({ id, name, town, category, seasons, latitude, longitude }) => ({ id, name, town, category, seasons, latitude, longitude }));
---
<div class="map-panel" id="map-panel" hidden>
  <div id="places-map" aria-label="Interactive map of source-listed locations"></div>
  <p class="map-note">{points.length} places have source-provided coordinates. Map points are approximate; confirm trailheads and access before travel. Listings without coordinates remain in the list.</p>
  <p class="map-error" role="status"></p>
</div>
<script type="application/json" id="map-data" set:html={safeJson(mapData)} />
