---
import { readFileSync } from 'node:fs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteUrl } from '../config.ts';
import { safeJson } from '../lib/listings.ts';
import { imageSources, heroSizes } from '../lib/images.ts';
interface Props {
  title: string;
  description: string;
  path?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  hero?: boolean;
  noindex?: boolean;
}
const { title, description, path = '/', schema, hero = false, noindex = false } = Astro.props;
const canonical = siteUrl + path;
const heroImage = hero ? await imageSources('/images/hero.webp') : undefined;
const socialImage = `${siteUrl}/images/social/teton-valley-trailhead-v2.jpg`;
const socialImageAlt = 'Go find your valley — the Teton Valley field guide to Victor and Driggs, Idaho, in pine, parchment, and rust with a photograph of the neighboring Teton Range.';
// Ship the small stylesheet with the HTML so
// the first screen never waits for a separate render-blocking CSS request.
const stylesheet = readFileSync('public/assets/styles.css', 'utf8');
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': siteUrl + '/#website', url: siteUrl + '/', name: 'Teton Valley', description: 'A source-linked guide to Victor, Driggs, and Teton Valley, Idaho.', inLanguage: 'en-US' },
    { '@type': 'Organization', '@id': siteUrl + '/#publisher', name: 'Teton Valley guide', url: siteUrl + '/', sponsor: { '@type': 'Organization', name: 'Teton Flats', url: 'https://tetonflats.com/' } },
    ...(schema ? Array.isArray(schema) ? schema : [schema] : []),
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    {heroImage && <link rel="preload" as="image" type="image/avif" href={heroImage.avif.src} imagesrcset={heroImage.avif.srcSet.attribute} imagesizes={heroSizes} fetchpriority="high" />}
    <link rel="preload" href="/assets/fonts/trailhead-v1/young-serif-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/trailhead-v1/mulish-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} | Teton Valley</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#233d2c" />
    <meta name="application-name" content="Teton Valley" />
    <meta name="apple-mobile-web-app-title" content="Teton Valley" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Teton Valley" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href="/favicon.ico?v=trailhead-2" type="image/x-icon" sizes="16x16 32x32 48x48 64x64 256x256" />
    <link rel="icon" href="/favicon-32x32.png?v=trailhead-2" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-96x96.png?v=trailhead-2" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.svg?v=trailhead-2" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=trailhead-2" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest?v=trailhead-2" />
    <link rel="alternate" type="application/json" href="/data/listings.json" title="Public directory data" />
    <link rel="llms-txt" href="/llms.txt" />
    <style is:inline set:html={stylesheet} />
    <script type="application/ld+json" set:html={safeJson(structuredData)} />
    <script src="../scripts/app.ts"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
