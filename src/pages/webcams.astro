---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import SponsorLink from '../components/SponsorLink.astro';
import { siteUrl } from '../config.ts';
import { webcamAreas } from '../lib/webcams.ts';
import '../styles/webcams.css';

const description = 'Check the latest webcam images over Teton Pass, along WY-22, and around Jackson and Teton Village before you drive from Victor or Driggs.';
const schema = { '@type': 'WebPage', name: 'Teton Pass & valley webcams', url: `${siteUrl}/webcams/`, description };
---
<SiteLayout title="Teton Pass & valley webcams" description={description} path="/webcams/" schema={schema}>
  <div class="page-intro section">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Webcams</span></nav>
    <div class="page-title-grid">
      <div><span class="eyebrow">Look before you leave</span><h1>Webcams</h1></div><p>{description}</p>
    </div>
    <p class="notice webcam-advisory">Images show the latest frame each camera has shared, not live video. Conditions change quickly. Check <a href="https://www.wyoroad.info/">WYDOT road reports</a> for closures and travel advisories.</p>
  </div>
  <section class="section webcams" aria-labelledby="webcams-heading" data-webcams>
    <h2 class="sr-only" id="webcams-heading">Camera images</h2>
    <div class="webcam-toolbar">
      <nav class="webcam-areas" aria-label="Camera areas" data-webcam-areas hidden>{webcamAreas.map(area => <a href={`#${area.id}`} data-area-link={area.id} hidden>{area.name}</a>)}</nav>
      <p class="webcam-status" data-webcam-status aria-live="polite">Loading cameras…</p>
    </div>
    <div data-webcam-groups></div>
    <noscript><p class="notice">Turn on JavaScript to load the latest camera images.</p></noscript>
  </section>
  <section class="section webcam-sources" aria-labelledby="webcam-sources-title">
    <h2 id="webcam-sources-title">About these cameras</h2>
    <p>Images come from Wyoming Department of Transportation road cameras, FAA weather cameras and parking cameras at Jackson Hole Airport, Jackson Hole Mountain Resort, and TetonCam, and are served from an image feed maintained by <SponsorLink placement="inline_text">Teton Flats</SponsorLink>. Each card names its source. Cameras marked “approximate location” have estimated coordinates in the feed.</p>
  </section>
  <dialog class="webcam-lightbox" aria-labelledby="webcam-lightbox-title" data-webcam-lightbox>
    <div class="webcam-lightbox-bar">
      <p class="webcam-lightbox-count" data-lightbox-count></p>
      <button class="webcam-lightbox-close" type="button" data-lightbox-close><Icon name="close" /><span class="sr-only">Close</span></button>
    </div>
    <figure class="webcam-lightbox-figure">
      <div class="webcam-lightbox-frame">
        <img alt="" data-lightbox-image />
        <span class="webcam-unavailable">Camera temporarily unavailable</span>
      </div>
      <figcaption><h2 id="webcam-lightbox-title" data-lightbox-title></h2><span class="webcam-meta" data-lightbox-meta></span><a class="text-link" target="_blank" rel="noopener" data-lightbox-full>Open full size <Icon name="northeast" /></a></figcaption>
    </figure>
    <button class="webcam-lightbox-nav webcam-lightbox-prev" type="button" data-lightbox-step="-1"><Icon name="arrow" /><span class="sr-only">Previous camera</span></button>
    <button class="webcam-lightbox-nav webcam-lightbox-next" type="button" data-lightbox-step="1"><Icon name="arrow" /><span class="sr-only">Next camera</span></button>
  </dialog>
  <script src="../scripts/webcams.ts"></script>
</SiteLayout>
