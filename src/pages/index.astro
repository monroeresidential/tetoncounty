---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ListingCard from '../components/ListingCard.astro';
import Photo from '../components/Photo.astro';
import { heroSizes } from '../lib/images.ts';
import { getListings, tag } from '../lib/listings.ts';
import type { Listing } from '../lib/listing-schema.ts';
import { categories, seasons } from '../config.ts';
const listings = await getListings();
const featured = ['Aspen Trail', 'Butter Cafe', 'Grand Teton Brewing', 'Music on Main']
  .map(name => listings.find(l => l.name.toLowerCase().replace('é', 'e').includes(name.toLowerCase())))
  .filter((item): item is Listing => Boolean(item));
const trailCount = listings.filter(l => l.trail).length;
const mappedTrails = listings.filter(l => l.trail && l.latitude != null && l.longitude != null).length;
const localTowns = ['Victor', 'Driggs'].filter(town => listings.some(l => l.town === town));
const homeCategories = categories.slice(0, 6);
const seasonNotes = ['runoff, first wildflowers', 'trails, rivers, Music on Main', 'aspens turn, quiet roads', 'Targhee powder, cold mornings'];
const aspen = featured.find(l => l.name.includes('Aspen'));
---
<SiteLayout title="Things to do in Victor & Driggs, Idaho" description="Go find your valley. Explore hiking trails, local food, shops, arts, and four-season adventures in Victor and Driggs with the Teton Valley field guide." hero>
  <section class="hero section">
    <div class="hero-heading">
      <span class="eyebrow hero-kicker">Trailhead · Elev. 6,200 ft</span>
      <h1>Go find<br />your <em>valley<svg viewBox="0 0 300 24" aria-hidden="true"><path d="M4 16c60-14 120 10 180-4s80-6 112 2" /></svg></em>.</h1>
      <p class="hero-intro">Trail days. Small-town favorites. Huckleberry milkshakes. {listings.length} places and experiences across Victor, Driggs and the valley in between.</p>
      <form class="hero-search" action="/explore/" method="get" role="search">
        <label class="sr-only" for="hero-query">Search the valley</label>
        <input id="hero-query" name="q" type="search" placeholder="A trail, a taco, a place to stay…" />
        <button class="btn btn-primary" type="submit">Find it <Icon name="arrow" /></button>
      </form>
      <div class="hero-quick"><a href="/hiking/">Hiking trails</a><a href="/categories/food-drink/">Coffee & good food</a><a href="/categories/arts-culture/">Music & events</a></div>
    </div>
    <div class="hero-photo-wrap">
      <figure class="plate hero-plate"><Photo src="/images/hero.webp" alt="The Teton Range and Snake River in neighboring Grand Teton National Park, Wyoming" sizes={heroSizes} priority /></figure>
      <span class="photo-sticker handwritten">The quiet side of the Tetons ↘</span>
      <span class="hero-stamp"><span>Est.<b>{listings.length}</b>good<br />reasons</span></span>
    </div>
  </section>
  <section class="section stats" aria-label="The guide at a glance">
    <div><span>{listings.length}</span><p>Places & experiences</p></div><div><span>{mappedTrails}</span><p>Mapped trails</p></div><div><span>{localTowns.length}</span><p>Towns, one valley</p></div><div><span>{seasons.length}</span><p>Seasons worth the drive</p></div>
  </section>
  <section class="section category-section">
    <div class="section-title"><h2>Which way<br />today?</h2><a class="text-link" href="/explore/">Explore everything <Icon name="arrow" /></a></div>
    <div class="signpost">{homeCategories.map((c, i) => <a class="trail-sign" href={`/categories/${c.id}/`} style={`--indent:${[0, 24, 8, 32, 16, 40][i]}px`}><span class="category-name">{c.name}</span><span class="category-count">{listings.filter(l => l.category === c.id).length} places <Icon name="arrow" /></span></a>)}</div>
  </section>
  <section class="section favorites">
    <div class="section-title"><h2>Local favorites</h2><span class="handwritten">← start here, honestly</span></div>
    <div class="featured-grid">{featured.map(item => <ListingCard item={item} feature />)}</div>
  </section>
  <section class="trail-feature">
    <svg class="torn-edge" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0h1440v30L1320 90 1200 40 1080 100 960 50 840 90 720 30 600 80 480 40 360 100 240 50 120 90 0 30Z" /></svg>
    <div class="section trail-feature-inner">
      <figure class="plate trail-feature-photo"><Photo src="/images/trail.webp" alt="A mountain path through the aspens" /><figcaption>Aspen Trail{aspen?.trail?.distanceMiles != null && ` · ${aspen.trail.distanceLabel || `${aspen.trail.distanceMiles} mi`}`}</figcaption></figure>
      <div class="trail-feature-text"><span class="eyebrow">Take the scenic route</span><h2>Less scrolling.<br />More trail time.</h2><p>{trailCount} source-listed routes, from a gentle valley walk to a long day in the high country. Pick one, pack a sandwich, go.</p><a class="btn btn-primary" href="/hiking/">Find your trail <Icon name="arrow" /></a></div>
    </div>
  </section>
  <section class="section towns-section" id="towns" aria-label="Victor and Driggs">
    <div class="town-grid">
      <a class="town-card" href="/towns/victor/"><span class="eyebrow">01 · South end · {listings.filter(l => l.town === 'Victor').length} places</span><h2>Victor</h2><p>Morning coffee, an afternoon outside, music in the park with the neighbors.</p><span class="handwritten">you are here ↓</span></a>
      <a class="town-card" href="/towns/driggs/"><span class="eyebrow">02 · Heart of it · {listings.filter(l => l.town === 'Driggs').length} places</span><h2>Driggs</h2><p>Independent shops, a creative downtown, and Targhee just up the road.</p></a>
    </div>
  </section>
  <section class="section season-grid" aria-label="Explore by season">{seasons.map((s, i) => <a href={`/explore/?season=${s}`}><span class="season-number">0{i + 1}</span><h2>{tag(s)}</h2><span class="handwritten">{seasonNotes[i]}</span></a>)}</section>
</SiteLayout>
