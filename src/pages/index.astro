---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ListingCard from '../components/ListingCard.astro';
import Photo from '../components/Photo.astro';
import { heroSizes } from '../lib/images.ts';
import { getListings, tag } from '../lib/listings.ts';
import type { Listing } from '../lib/listing-schema.ts';
import { categories, seasons } from '../config.ts';
const listings = await getListings();
const featured = ['Aspen Trail', 'Butter Cafe', 'Grand Teton Brewing', 'Music on Main']
  .map(name => listings.find(l => l.name.toLowerCase().replace('é', 'e').includes(name.toLowerCase())))
  .filter((item): item is Listing => Boolean(item));
const trailCount = listings.filter(l => l.trail).length;
const categoryPhotos = ['river', 'cafe', 'music', 'valley', 'balloons', 'ski'];
const homeCategories = categories.slice(0, 6);
---
<SiteLayout title="Things to do in Victor & Driggs, Idaho" description="Your field guide to Teton Valley, Idaho. Discover hiking trails, local restaurants, shops, arts, and four-season adventures in Victor and Driggs." hero>
  <section class="hero section">
    <div class="hero-heading">
      <h1><span>A small valley.</span><span>A whole lot <em>to discover.</em></span></h1>
      <div class="hero-intro"><p>Trail days, small-town favorites and the kind of places that make you stay a little longer. {listings.length} source-listed spots across two towns and four seasons.</p>
        <div class="hero-quick"><a href="/hiking/">Hiking trails</a><a href="/categories/food-drink/">Coffee & good food</a><a href="/categories/arts-culture/">Arts & events</a></div>
      </div>
    </div>
    <form class="hero-search" action="/explore/" method="get" role="search">
      <label class="sr-only" for="hero-query">Search the valley</label><Icon name="search" />
      <input id="hero-query" name="q" type="search" placeholder="A trail, a taco, your next favorite place…" />
      <button class="btn btn-primary" type="submit">Find your adventure <Icon name="arrow" /></button>
    </form>
    <figure class="plate hero-plate">
      <Photo src="/images/hero.webp" alt="The Teton Range and Snake River in neighboring Grand Teton National Park, Wyoming" sizes={heroSizes} priority />
      <figcaption class="photo-caption"><span>The Teton Range from the Snake River · Photo NPS</span><span>The quiet side of the Tetons ✳</span></figcaption>
    </figure>
  </section>
  <section class="section stats" aria-label="The guide at a glance">
    <div><span>{listings.length}</span><p>Source-listed places & experiences</p></div><div><span>2</span><p>Towns, a valley in between</p></div><div><span>{trailCount}</span><p>Hiking routes on the trail map</p></div><div><span>4</span><p>Seasons, each with its own list</p></div>
  </section>
  <section class="section category-section">
    <div><span class="eyebrow">Follow your curiosity</span><h2>What’s your kind of day?</h2>
      <div class="category-index">{homeCategories.map((c, i) => <a href={`/categories/${c.id}/`} data-category-photo={i}><span class="index-number">0{i + 1}</span><span class="category-name">{c.name}</span><span class="category-count">{listings.filter(l => l.category === c.id).length} places <Icon name="northeast" /></span></a>)}</div>
      <a class="text-link category-all" href="/explore/">Explore everything <Icon name="arrow" /></a>
    </div>
    <figure class="plate category-plate" aria-hidden="true">
      {categoryPhotos.map((photo, i) => <Photo src={`/images/${photo}.webp`} alt="" hidden={i !== 0} categoryIndex={i} />)}
      <figcaption class="photo-caption" id="category-caption">{homeCategories[0].name}</figcaption>
    </figure>
  </section>
  <section class="section favorites">
    <div class="section-title"><div><span class="eyebrow">A few good places to start</span><h2>Your next valley favorite.</h2></div><a class="text-link" href="/explore/">All local spots <Icon name="arrow" /></a></div>
    <div class="featured-grid">{featured.map(item => <ListingCard item={item} feature />)}</div>
  </section>
  <section class="trail-feature">
    <span class="trail-numeral" aria-hidden="true">{trailCount}</span>
    <div class="trail-feature-text"><span class="eyebrow">Take the scenic route</span><h2>Less scrolling.<br />More trail time.</h2><p>From a gentle valley walk to a day in the high country. {trailCount} source-listed routes, each with a map point and the details to start planning.</p><a class="btn btn-primary" href="/hiking/">Find your trail <Icon name="arrow" /></a></div>
    <figure class="plate trail-feature-photo"><Photo src="/images/trail.webp" alt="A mountain path through the aspens" /><figcaption class="photo-caption">Aspen Trail · A little fresh air goes a long way</figcaption></figure>
  </section>
  <section class="section towns-section" id="towns">
    <span class="eyebrow">Same valley, their own kind of magic</span>
    <div class="town-grid">
      <a class="town-card" href="/towns/victor/"><span class="eyebrow">01 · At the south end</span><h2>Hello, Victor.</h2><p>Morning coffee, an afternoon outside, and music with the neighbors. Settle into the rhythm. {listings.filter(l => l.town === 'Victor').length} places.</p><span class="text-link">Explore Victor <Icon name="arrow" /></span></a>
      <a class="town-card" href="/towns/driggs/"><span class="eyebrow">02 · At the heart of it all</span><h2>Meet Driggs.</h2><p>Independent shops, a creative downtown, and mountain adventures just up the road. {listings.filter(l => l.town === 'Driggs').length} places.</p><span class="text-link">Explore Driggs <Icon name="arrow" /></span></a>
    </div>
  </section>
  <section class="season-strip" aria-label="Explore by season"><div class="season-marquee">{[0, 1].map(copy => <div class="season-group" aria-hidden={copy === 1 ? 'true' : undefined}>{seasons.map((s, i) => <a href={`/explore/?season=${s}`} tabindex={copy === 1 ? -1 : undefined}><span>0{i + 1}</span>{tag(s)}<span class="season-star" aria-hidden="true">✳</span></a>)}</div>)}</div></section>
</SiteLayout>
