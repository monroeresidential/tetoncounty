---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ListingCard from '../components/ListingCard.astro';
import { getListings, tag } from '../lib/listings.ts';
import type { Listing } from '../lib/listing-schema.ts';
import { categories, seasons } from '../config.ts';
const listings = await getListings();
const featured = ['Grand Teton Brewing', 'Aspen Trail', 'Butter Cafe', 'Music on Main']
  .map(name => listings.find(l => l.name.toLowerCase().replace('é', 'e').includes(name.toLowerCase())))
  .filter((item): item is Listing => Boolean(item));
const trailCount = listings.filter(l => l.trail).length;
---
<SiteLayout title="Things to do in Victor & Driggs, Idaho" description="Find your kind of day in Teton Valley. Explore restaurants, hiking trails, local shops, arts, and things to do in Victor and Driggs, Idaho." hero>
  <section class="hero">
    <img class="hero-image" src="/images/hero.webp" alt="The Teton Range and Snake River in neighboring Grand Teton National Park, Wyoming" width="1920" height="1280" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="hero-content">
      <span class="eyebrow"><span class="little-line"></span> VICTOR. DRIGGS. WIDE OPEN POSSIBILITY.</span>
      <h1>A small valley.<br /><em>A whole lot to discover.</em></h1>
      <p>Trail days. Small-town favorites. The kind of places<br class="desktop-only" /> that make you stay a little longer.</p>
      <form class="hero-search" action="/explore/" method="get" role="search">
        <label class="sr-only" for="hero-query">Search the valley</label><Icon name="search" />
        <input id="hero-query" name="q" type="search" placeholder="A trail, a taco, your next favorite place…" />
        <button type="submit">Find your adventure <Icon name="arrow" /></button>
      </form>
      <div class="hero-quick"><span>A few ways to start</span><a href="/hiking/">Hiking trails ↗</a><a href="/categories/food-drink/">Coffee & good food ↗</a><a href="/categories/arts-culture/">Arts & events ↗</a></div>
    </div>
    <div class="hero-bottom"><span><Icon name="pin" /> THE TETON REGION · PHOTO: NPS</span><span>THE QUIET SIDE OF THE TETONS <span class="compass">✳</span></span></div>
  </section>
  <section class="intro-strip"><p>Big mountains. <strong>Small-town soul.</strong></p><span>{listings.length} source-listed places & experiences</span><i></i><span>Two towns. Four seasons.</span><a href="/about/">Meet your local guide <Icon name="arrow" /></a></section>
  <section class="section categories-section">
    <div class="section-title"><div><span class="eyebrow green">FOLLOW YOUR CURIOSITY</span><h2>What’s your kind of day?</h2></div><a class="text-link" href="/explore/">Explore everything <Icon name="arrow" /></a></div>
    <div class="category-grid">{categories.slice(0, 6).map(c => <a class="category-tile" href={`/categories/${c.id}/`}><span class="category-icon"><Icon name={c.icon} /></span><h3>{c.name}</h3><span>{listings.filter(l => l.category === c.id).length} places & experiences <Icon name="northeast" /></span></a>)}</div>
  </section>
  <section class="section favorites">
    <div class="section-title"><div><span class="eyebrow green">A FEW GOOD PLACES TO START</span><h2>Find your next valley favorite.</h2></div><a class="text-link" href="/explore/">All local spots <Icon name="arrow" /></a></div>
    <div class="featured-grid">{featured.map(item => <ListingCard item={item} feature />)}</div>
  </section>
  <section class="trail-feature">
    <div class="trail-feature-photo"><img src="/images/trail.webp" alt="A mountain path through the aspens" width="800" height="600" loading="lazy" /><span class="photo-caption">A LITTLE FRESH AIR GOES A LONG WAY.</span></div>
    <div class="trail-feature-text"><span class="eyebrow">TAKE THE SCENIC ROUTE</span><h2>Less scrolling.<br />More trail time.</h2><p>From a gentle valley walk to a day in the high country. Find hiking routes, source map points, and the details to start planning.</p><a class="button light" href="/hiking/">Find your trail <Icon name="arrow" /></a><div class="trail-feature-note"><Icon name="map" /> {trailCount} source-listed routes · Interactive trail map</div></div>
  </section>
  <section class="section towns-section">
    <div class="section-title"><div><span class="eyebrow green">SAME VALLEY. THEIR OWN KIND OF MAGIC.</span><h2>Get to know the neighborhood.</h2></div></div>
    <div class="town-grid">
      <a class="town-card" href="/towns/victor/"><div><span class="eyebrow">AT THE SOUTH END</span><h3>Hello, Victor.</h3><p>Morning coffee, an afternoon outside, and music with the neighbors. Settle into the rhythm.</p><span class="text-link">Explore Victor <Icon name="arrow" /></span></div><span class="town-number">01</span></a>
      <a class="town-card driggs" href="/towns/driggs/"><div><span class="eyebrow">AT THE HEART OF IT ALL</span><h3>Meet Driggs.</h3><p>Independent shops, a creative downtown, and mountain adventures just up the road.</p><span class="text-link">Explore Driggs <Icon name="arrow" /></span></div><span class="town-number">02</span></a>
    </div>
  </section>
  <section class="season-strip section"><span class="eyebrow green">THERE’S A SEASON FOR EVERYTHING</span><div>{seasons.map((s, i) => <a href={`/explore/?season=${s}`}><span>0{i + 1}</span>{tag(s)}<Icon name="northeast" /></a>)}</div></section>
</SiteLayout>
