---
import SiteLayout from '../layouts/SiteLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { isDevelopment, siteUrl } from '../config.ts';
import { rentalSnapshot as snapshot } from '../data/rental-market.ts';
import { rentalGroups, rentalPlans, rentalTowns, dollars, planLabel, rentDifference } from '../lib/rental-market.ts';
import '../styles/live.css';

const groups = { communities: 'Apartment communities', 'all-direct': 'All direct listings' };
const referral = (path: string, placement: string) => `https://tetonflats.com/${path}?utm_source=${isDevelopment ? 'dev.tetoncounty.us' : 'tetoncounty.us'}&utm_medium=referral&utm_campaign=live_here&utm_content=${placement}`;
const availability = referral('availability', 'comparison');
const schema = {
  '@type': 'WebPage', name: 'Live here — Teton Flats & local rental comparisons', url: `${siteUrl}/live/`,
  description: 'A sponsored introduction to Teton Flats in Victor, with an undated draft rental comparison for Victor, Driggs, and Jackson.',
  about: { '@type': 'ApartmentComplex', name: 'Teton Flats', url: 'https://tetonflats.com/', address: { '@type': 'PostalAddress', streetAddress: '100 Homestead Road', addressLocality: 'Victor', addressRegion: 'ID', postalCode: '83455', addressCountry: 'US' } },
};
---
<SiteLayout title="Live here — Teton Flats & local rental comparisons" description="Meet Teton Flats in Victor, Idaho. Explore the apartments, compare a rental-market snapshot for Victor, Driggs, and Jackson, and find your mountain-town home." path="/live/" schema={schema} noindex>
  <section class="section live-hero" aria-labelledby="live-title">
    <div class="live-hero-copy">
      <span class="eyebrow">Live here · Teton Valley, Idaho</span>
      <h1 id="live-title">Make this<br />your <em>everyday.</em></h1>
      <p class="live-lead">The morning coffee. The trail after work. A place for your gear, and a place to call your own.</p>
      <p>Meet <strong>Teton Flats</strong>: one- and two-bedroom apartments in Victor. Start with a look inside, then see how the rents compare across the valley and over the pass.</p>
      <div class="live-actions"><a class="btn live-rust-button" href={referral('availability', 'hero')} rel="sponsored">See Teton Flats availability <Icon name="northeast" /></a><a class="text-link" href="#compare">Compare the rents <Icon name="arrow" /></a></div>
      <p class="live-sponsor-note">Featured community & guide sponsor: Teton Flats</p>
    </div>
    <figure class="live-postcard">
      <div class="live-hero-photo"><Photo src="/images/teton-flats-exterior.webp" alt="Wood and dark metal apartment buildings at Teton Flats in Victor, with golden grasses and wooded hills" sizes="(max-width: 760px) calc(100vw - 64px), (max-width: 1100px) 45vw, 600px" priority /></div>
      <figcaption><span class="handwritten">Your next chapter, right here.</span><span>100 Homestead Road · Victor, ID</span></figcaption>
      <span class="live-photo-label">Meet Teton Flats</span>
    </figure>
  </section>

  <nav class="section live-jump-links" aria-label="On this page"><a href="#compare">01 / Compare rents</a><a href="#teton-flats">02 / Inside Teton Flats</a><a href="#home-base">03 / Find your home base</a><a href="#rent-sources">04 / The details</a></nav>

  <section class="live-compare-wrap" id="compare" aria-labelledby="compare-title">
    <div class="section">
      <div class="live-section-heading"><div><span class="eyebrow">A little perspective</span><h2 id="compare-title">Same region.<br />Different rent.</h2></div><p>Put Teton Flats alongside the local rental sample. Choose a layout and comparison group to see the difference in advertised base rent.</p></div>
      <div class="rent-snapshot-note"><Icon name="info" /><p><strong>Preview rent snapshot · date not supplied.</strong> These figures come from an undated market survey, not a live availability feed. <a href="#rent-sources">How we compare</a></p></div>
      <form class="rent-controls" data-rent-controls hidden aria-label="Rental comparison filters">
        <fieldset><legend>Choose your layout</legend><div class="rent-plan-options"><label><input type="radio" name="plan" value="1x1" checked /><span>1 bed / 1 bath</span></label><label><input type="radio" name="plan" value="2x2" /><span>2 beds / 2 baths</span></label></div></fieldset>
        <label class="rent-group-label">Compare with<select name="group"><option value="all-direct">All direct listings</option><option value="communities">Apartment communities</option></select></label>
      </form>
      <p class="sr-only" data-rent-announcement aria-live="polite" aria-atomic="true"></p>
      <noscript><p class="rent-no-script">Both layouts and comparison groups are shown below. Each group is a separate sample.</p></noscript>
      {rentalGroups.map(group => rentalPlans.map(plan => {
        const sponsor = snapshot.sponsor.find(row => row.plan === plan)!;
        const comparisons = snapshot.comparisons.filter(row => row.group === group && row.plan === plan);
        const maxMedian = Math.max(sponsor.medianBase, ...comparisons.map(row => row.median));
        return <div class="rent-panel" data-rent-panel data-plan={plan} data-group={group}>
          <h3 class="rent-panel-title">{planLabel(plan)} <span>· {groups[group]}</span></h3>
          <div class="rent-card-grid">
            <article class="rent-card rent-card-featured">
              <span class="rent-card-kicker">Our featured community</span><h3>Teton Flats</h3><span class="rent-card-location">Victor, Idaho</span>
              <div class="rent-price">{dollars(sponsor.medianBase)}<small>/mo</small></div><p class="rent-price-caption">Median base rent in snapshot</p>
              <div class="rent-bar" aria-hidden="true"><span style={`width:${sponsor.medianBase / maxMedian * 100}%`}></span></div>
              <dl class="rent-fees"><div><dt>Monthly CAM*</dt><dd>+ {dollars(sponsor.monthlyCam)}</dd></div><div><dt>Base + CAM</dt><dd>{dollars(sponsor.medianBase + sponsor.monthlyCam)}</dd></div></dl>
              <p class="rent-sample">{sponsor.records} source records · {planLabel(plan)}</p>
              <a class="btn" href={availability} rel="sponsored">Check availability <Icon name="northeast" /></a>
              <span class="rent-card-disclosure">Sponsored feature</span>
            </article>
            {rentalTowns.map(town => {
              const row = comparisons.find(item => item.town === town);
              return <article class="rent-card"><span class="rent-card-kicker">{town === 'Jackson' ? 'Over the pass' : 'In the valley'}</span><h3>{town}</h3><span class="rent-card-location">{town === 'Jackson' ? 'Wyoming' : 'Idaho'} rental sample</span>
                {row ? <><div class="rent-price">{dollars(row.median)}<small>/mo</small></div><p class="rent-price-caption">Median advertised base rent</p><div class="rent-bar" aria-hidden="true"><span style={`width:${row.median / maxMedian * 100}%`}></span></div>
                  <p class="rent-difference">{rentDifference(sponsor.medianBase, row.median)}</p>
                  <dl class="rent-fees"><div><dt>Sample range</dt><dd>{dollars(row.min)}–{dollars(row.max)}</dd></div><div><dt>Additional fees</dt><dd>Not supplied</dd></div></dl>
                  <p class="rent-sample">{row.records} source {row.records === 1 ? 'record' : 'records'} · {row.properties} {row.properties === 1 ? 'property' : 'properties'}</p>
                  <details class="rent-examples"><summary>See the comparison names <span aria-hidden="true">+</span></summary><p>Examples from the survey; these are not confirmed available units.</p><ul>{row.examples.map(example => <li><span>{example.name}</span><b>{dollars(example.baseRent)}</b></li>)}</ul></details>
                </> : <div class="rent-empty"><Icon name="home" /><p>No matching {planLabel(plan).toLowerCase()} community sample.</p><span>Try “All direct listings” for a broader view. Two-bedroom homes with an unspecified bathroom count are excluded here.</span></div>}
              </article>;
            })}
          </div>
          <p class="rent-comparison-footnote">{group === 'communities' ? 'Apartment communities only. A small sample may reflect a single property.' : 'The broader sample includes apartment communities, individual rentals, condos, and accessory homes.'} Differences compare base rent only; they are not total monthly savings.</p>
        </div>;
      }))}
      <p class="rent-fee-note">*CAM is the monthly common-area maintenance charge reported for Teton Flats. Base + CAM is a known subtotal, not an all-in quote. Utilities, pets, deposits, other charges, lease terms, and concessions must be confirmed with each property.</p>
    </div>
  </section>

  <section class="section live-inside" id="teton-flats" aria-labelledby="inside-title">
    <figure class="live-interior"><Photo src="/images/teton-flats-interior.webp" alt="A furnished Teton Flats model living room with an open kitchen, wood flooring, and stainless appliances" /><figcaption class="photo-caption">Room for the everyday, too.</figcaption></figure>
    <div><span class="eyebrow">A closer look · Teton Flats</span><h2 id="inside-title">Come home.<br />Spread out.</h2><p class="live-lead">A mountain-town address, with the comforts you use every day.</p><p>Quartz counters for the first coffee. In-home laundry after a muddy trail. Dedicated storage for the gear you’ll actually use.</p><ul class="live-features"><li><Icon name="home" />In-unit washer & dryer</li><li><Icon name="sun" />Air conditioning</li><li><Icon name="bag" />Dedicated gear storage</li><li><Icon name="mountain" />Victor, Idaho location</li></ul>
      <a class="text-link" href={referral('gallery', 'inside')} rel="sponsored">Explore the photo gallery <Icon name="northeast" /></a><p class="live-photo-credit">Photos and apartment features via <a href="https://tetonflats.com/floorplans" rel="sponsored">Teton Flats</a>. Model furnishings are shown.</p>
    </div>
  </section>
  <section class="section live-layouts" aria-labelledby="layouts-title">
    <div class="live-section-heading"><div><span class="eyebrow">Find your fit</span><h2 id="layouts-title">A little room.<br />Or a little more.</h2></div><p>Explore the layouts and ask the leasing team which homes are available for your move.</p></div>
    <div class="live-layout-grid">{[{ name: 'The one-bedroom', details: '1 bed · 1 bath', area: '640', note: 'A separate bedroom. An open living space.' }, { name: 'The duplex', details: '1 bed · 1 bath', area: '622', note: 'A one-bedroom layout with ground-floor entry.' }, { name: 'The two-bedroom', details: '2 beds · 2 baths', area: '980', note: 'Another bedroom, another bathroom, more options.' }].map((layout, index) => <a class="live-layout-card" href={referral('floorplans', `layout-${index + 1}`)} rel="sponsored"><span class="live-layout-number">0{index + 1} / {layout.details}</span><h3>{layout.name}</h3><div class="live-area">{layout.area}<span>sq ft</span></div><p>{layout.note}</p><span class="text-link">View floor plan <Icon name="northeast" /></span></a>)}</div>
  </section>

  <section class="section live-towns" id="home-base" aria-labelledby="base-title"><div class="live-section-heading"><div><span class="eyebrow">Rent is one part of the picture</span><h2 id="base-title">Find your<br />home base.</h2></div><p>Think about where you work, where you spend your weekends, and the drive you want to make in every season.</p></div>
    <div class="live-town-grid"><article><span class="handwritten">Teton Flats is here ↓</span><h3>Victor</h3><p>Make the south end of Teton Valley your starting point. Explore local coffee, restaurants, music, and trails around your next home.</p><a class="text-link" href="/towns/victor/">Meet Victor <Icon name="arrow" /></a></article><article><span class="live-town-label">The heart of the valley</span><h3>Driggs</h3><p>Explore downtown shops, local food, and the community on the Idaho side. Compare the drive to work with the places you’ll visit most.</p><a class="text-link" href="/towns/driggs/">Meet Driggs <Icon name="arrow" /></a></article><article><span class="live-town-label">Across Teton Pass · Wyoming</span><h3>Jackson</h3><p>If work takes you to Jackson, weigh the rent difference against the commute. Winter weather and pass closures can change the trip.</p><a class="text-link" href="https://tetonflats.com/victor-to-jackson-commute" rel="sponsored">Read the commute guide <Icon name="northeast" /></a></article></div>
  </section>

  <section class="section live-source-section" id="rent-sources" aria-labelledby="sources-title"><span class="eyebrow">Know what’s behind the numbers</span><h2 id="sources-title">Clear comparisons.<br />No fine-print surprises.</h2><div class="live-source-grid"><div><h3>A snapshot, not a quote.</h3><p>The rent figures are from a supplied market survey. It contains no observation dates, original listing URLs, or full fee schedules. We keep it labeled as an undated draft and link to Teton Flats for current availability.</p><p>Only matching one-bed/one-bath and two-bed/two-bath summaries are used. Stale search snippets, all-town totals, and overlapping “all two-bedroom” summaries are excluded. Record counts are survey rows, not a count of available homes.</p></div><div><h3>The same rules for everyone.</h3><p>Town figures are the survey’s reported medians, excluding Teton Flats. Comparison groups overlap, so we never add them together. We don’t reconstruct medians from the example names, which may omit repeated observations.</p><p>Teton Flats sponsors this guide and receives the featured placement. Other properties’ amenities and fees are not assumed to match. A full daily feed needs dated, source-linked listings before these figures can be presented as current.</p></div></div><div class="live-source-links"><a class="text-link" href="/data/rental-market.json">Read the comparison data <Icon name="arrow" /></a><a class="text-link" href="/suggest/?type=contact">Suggest a rent correction <Icon name="arrow" /></a></div></section>

  <section class="section live-final-cta"><div><span class="handwritten">More than a weekend.</span><h2>Picture your life<br />at Teton Flats.</h2><p>Find a layout you like. Check the latest availability. Come take a look.</p></div><div class="live-final-actions"><a class="btn" href={referral('availability', 'closing')} rel="sponsored">See available apartments <Icon name="northeast" /></a><a class="btn btn-secondary" href={referral('contact', 'tour')} rel="sponsored">Schedule a tour <Icon name="arrow" /></a><span>Leasing inquiries go directly to Teton Flats.</span></div></section>
  <script src="../scripts/live.ts"></script>
</SiteLayout>
